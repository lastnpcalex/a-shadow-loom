import LoomCoordination.Model
import LoomCoordination.Launch
import Lean
open LoomCoordination
open Lean

def str (s : String) : Lean.Json := toJson s
def outcomeName : Outcome → String
  | .pending => "pending" | .completed => "completed" | .failed => "failed"
  | .cancelled => "cancelled" | .interrupted => "interrupted"
def queueName : Queue → String
  | .waiting => "waiting" | .paused => "paused" | .dispatched => "dispatched"
def effectName : Effect → String
  | .none => "none" | .releaseLease => "release_lease"
  | .launchQueued => "launch_queued" | .pauseQueue => "pause_queue"
def stateJson (s : State) : Lean.Json := toJson ([str (outcomeName s.outcome), toJson s.exited,
  toJson s.leased, str (queueName s.queue), toJson s.authorized, toJson s.diagnostic] : List Lean.Json)
def eventJson : Event → Lean.Json
  | .toolData text => toJson [str "tool_data", str text]
  | .terminal outcome => toJson [str "terminal", str (outcomeName outcome)]
  | .stop interrupt => toJson [str "stop", toJson interrupt]
  | .diagnosticError => toJson [str "diagnostic_error"]
  | .processExited => toJson [str "process_exited"]
  | .release => toJson [str "release"]
  | .resumeQueue => toJson [str "resume_queue"]
  | .dispatch => toJson [str "dispatch"]
def outcomes : List Outcome := [.pending, .completed, .failed, .cancelled, .interrupted]
def queues : List Queue := [.waiting, .paused, .dispatched]
def bools := [false, true]
def states : List State := outcomes.flatMap fun o => bools.flatMap fun x => bools.flatMap fun l =>
  queues.flatMap fun q => bools.flatMap fun a => bools.map fun d => ⟨o,x,l,q,a,d⟩
def events : List Event := [.toolData "", .toolData "runner pipe-in: timed out", .diagnosticError,
  .terminal .pending, .terminal .completed, .terminal .failed, .terminal .cancelled,
  .terminal .interrupted, .stop false, .stop true, .processExited, .release, .resumeQueue, .dispatch]
def rows : List Lean.Json := states.flatMap fun s => events.map fun e =>
  let (next, effect) := step s e
  toJson [stateJson s, eventJson e, stateJson next, str (effectName effect), toJson (failed next)]
def views : List Lean.Json := bools.flatMap fun landed => bools.flatMap fun same => bools.map fun incoming =>
  let (next, accepted) := viewStep ⟨landed⟩ same incoming
  toJson [toJson [landed, same, incoming], toJson [next.landed, accepted]]

-- Trace expectations are generated by the proved reducer, not copied from
-- Python. Exhaustive one-step cases complement (not replace) trace induction.
def traces : List (List Event) := [
  [.diagnosticError, .toolData "failed", .terminal .completed, .release, .processExited, .release, .dispatch, .dispatch],
  [.stop false, .terminal .completed, .dispatch, .processExited, .release, .dispatch, .resumeQueue, .dispatch],
  [.stop true, .processExited, .release, .dispatch, .resumeQueue, .dispatch],
  [.processExited, .release, .dispatch],
  [.terminal .completed, .processExited, .release, .terminal .failed, .dispatch]
]
def traceJson (events : List Event) : Lean.Json := Id.run do
  let mut state : State := {}
  let mut rows : List Lean.Json := []
  for event in events do
    let (next, effect) := step state event
    rows := rows ++ [toJson [eventJson event, stateJson next, str (effectName effect)]]
    state := next
  return toJson rows

def launchName : LaunchView → String
  | .idle => "idle" | .submitting => "submitting" | .running => "running"
  | .reconciling => "reconciling" | .landed => "landed" | .failed => "failed"

def launchEventName : LaunchEvent → String
  | .submit => "submit" | .admitted => "admitted" | .disconnected => "disconnected"
  | .terminal => "terminal" | .rejected => "rejected"

def launchRows : List Lean.Json := Id.run do
  let mut result := []
  for state in ([.idle, .submitting, .running, .reconciling, .landed, .failed] : List LaunchView) do
    for event in ([.submit, .admitted, .disconnected, .terminal, .rejected] : List LaunchEvent) do
      result := result ++ [toJson [launchName state, launchEventName event, launchName (launchStep state event)]]
  return result

def main (args : List String) : IO Unit := do
  match args with
  | [path] =>
    let payload := "{\"version\":1,\"steps\":[\n" ++ String.intercalate ",\n" (rows.map Lean.Json.compress) ++
      "\n],\"views\":" ++ (toJson views).compress ++ ",\"traces\":" ++ (toJson (traces.map traceJson)).compress ++ "}\n"
    IO.FS.writeFile ⟨path⟩ payload
    IO.FS.writeFile ⟨path ++ ".launch.json"⟩ ((toJson launchRows).compress ++ "\n")
    IO.println s!"Generated {rows.length} transitions, {views.length} view cases, {traces.length} traces."
  | _ => throw <| IO.userError "usage: coordination_fixtures OUTPUT_PATH"
